# Copy to .env for local development. Set these variables in Railway for production.
# Generate a unique secret with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-generated-secret-key
ENV=dev

# PostgreSQL: create this database and user before running migrations.
# URL-encode special characters in the username/password.
# Production: ENV=prod and DATABASE_URL from the Railway PostgreSQL service.
DATABASE_URL=postgresql://cgato:replace-with-your-postgres-password@localhost:5432/cgato
